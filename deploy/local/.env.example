# Local development environment for Yawar (docker compose).
# `make up` copies this file to deploy/local/.env (git-ignored) if it does not exist.
# These are DUMMY values for a local laptop only. Change them in .env, never here.

COMPOSE_PROJECT_NAME=yawar

# --- PostgreSQL 16 (one instance locally, one database + user per service) ---
POSTGRES_USER=yawar_admin
POSTGRES_PASSWORD=change-me-postgres
DONORS_DB_NAME=donors_db
DONORS_DB_USER=donors_app
DONORS_DB_PASSWORD=change-me-donors
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# --- RabbitMQ ---
RABBITMQ_USER=yawar
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOSTS="yawar-dev yawar-qa"

# --- Keycloak (bootstrap admin of the master realm) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# --- Keycloak realm as code (YAW-31): deploy/keycloak/realms/<KC_IMPORT_REALM>.yaml ---
KC_IMPORT_REALM=yawar-dev
KC_WEB_URL=http://localhost:5173
# Google sign-in (HU-02): create an OAuth client in Google Cloud with the redirect URI
# http://localhost:8080/realms/yawar-dev/broker/google/endpoint, then set these three in .env only.
KC_GOOGLE_ENABLED=false
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=

# --- Host ports ---
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Discovery service / Eureka (YAW-217, `make up PROFILE=platform`) ---
DISCOVERY_PORT=8761
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me-eureka
