# Local development environment for Yawar (docker compose).
# `make up` copies this file to deploy/local/.env (git-ignored) if it does not exist.
# These are DUMMY values for a local laptop only. Change them in .env, never here.

COMPOSE_PROJECT_NAME=yawar

# --- PostgreSQL 16 (one instance locally, one database + user per service) ---
POSTGRES_USER=yawar_admin
POSTGRES_PASSWORD=change-me-postgres
DONORS_DB_NAME=donors_db
DONORS_DB_USER=donors_app
DONORS_DB_PASSWORD=change-me-donors
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# --- RabbitMQ ---
RABBITMQ_USER=yawar
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOSTS="yawar-dev yawar-qa"

# --- Redis (API Gateway rate limiter, YAW-33) ---
REDIS_PASSWORD=change-me-redis

# --- Keycloak (bootstrap admin of the master realm) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# --- Keycloak realm as code (YAW-31): deploy/keycloak/realms/<KC_IMPORT_REALM>.yaml ---
KC_IMPORT_REALM=yawar-dev
KC_WEB_URL=http://localhost:5173
# Google sign-in (HU-02): create an OAuth client in Google Cloud (steps and redirect URIs, local and qa, in
# deploy/keycloak/README.md, "Enabling Google sign-in"), then set these three in .env only, never in Git.
KC_GOOGLE_ENABLED=false
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=

# Active Directory federation of the staff (YAW-32, HU-32): needs `make up PROFILE=ad`, `make ad-seed` and `make ad-cert`
# BEFORE Keycloak starts (it trusts the lab CA at startup). KC_AD_ENABLED=false imports the realm with the provider off.
# The bind account is the read-only svc.keycloak created by `make ad-seed`; its password is in
# deploy/ad/.secrets/passwords.env (SVC_KEYCLOAK). Set it in .env only, never here.
KC_AD_ENABLED=false
KC_AD_URL=ldaps://samba-ad:636
KC_AD_BIND_DN=CN=svc.keycloak,OU=Servicios,OU=Yawar,DC=yawar,DC=lab
KC_AD_BIND_PASSWORD=

# --- Host ports ---
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# OIDC stub that stands in for Google in `make keycloak-check` (`make up PROFILE=idp-mock`).
IDP_MOCK_PORT=8099
DONORS_PORT=8081
GATEWAY_PORT=8000
REDIS_PORT=6379
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Discovery service / Eureka (YAW-217, `make up PROFILE=platform`) ---
DISCOVERY_PORT=8761
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me-eureka
# --- API Gateway (YAW-33, `make up PROFILE=gateway` or `platform`) ---
# Origins allowed by CORS, comma separated (patterns: http://localhost:[*] = any port). Default = these values.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:[*],http://localhost,https://localhost,capacitor://localhost
# --- Config Server (YAW-216, `make up PROFILE=platform`) ---
CONFIG_SERVER_PORT=8888
# Client user (every service, read-only) and admin user (POST /busrefresh)
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=change-me-config
CONFIG_ADMIN_USER=config-admin
CONFIG_ADMIN_PASSWORD=change-me-config-admin
# native = local folder YAWAR_CONFIG_DIR (relative to deploy/local) · git = private repo with a read-only token
CONFIG_SERVER_PROFILES=native
YAWAR_CONFIG_DIR=../../../yawar-config
CONFIG_GIT_URI=https://github.com/yawar-uce/yawar-config.git
CONFIG_GIT_USERNAME=x-access-token
# Fine-grained read-only token for yawar-uce/yawar-config: set it in .env only, never here.
CONFIG_GIT_TOKEN=

# --- Samba AD (YAW-30, `make up PROFILE=ad`): realm yawar.lab, staff users via `make ad-seed` ---
# Administrator password: REQUIRED, replace CHANGE_ME in .env only. AD complexity: 8+ chars, 3 of upper/lower/digit/symbol.
AD_ADMIN_PASSWORD=CHANGE_ME
AD_REALM=YAWAR.LAB
AD_DOMAIN=YAWAR
AD_LDAPS_PORT=636
